# FedXAI-Med environment template
# Copy to .env and fill locally. NEVER commit .env, tokens, or patient data.

# --- Runtime ---
APP_NAME=FedXAI-Med
APP_ENV=development
DEV_MODE=true
LOG_LEVEL=
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database (central metadata only; no raw hospital images) ---
DATABASE_URL=postgresql+psycopg://fedxai:fedxai@localhost:5432/fedxai_med

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Model / training ---
MODEL_NAME=densenet121
IMAGE_SIZE=224
BATCH_SIZE=8
LEARNING_RATE=1e-4
WEIGHT_DECAY=1e-4
NUM_EPOCHS=10
NUM_WORKERS=0
MIXED_PRECISION=false
DEVICE=auto

# --- Federated learning ---
FL_ALGORITHM=fedavg
NUM_CLIENTS=5
LOCAL_EPOCHS=1
FL_ROUNDS=10
FEDPROX_MU=0.01
CLIENT_FRACTION=1.0

# --- Differential privacy (utility–privacy tradeoff; not perfect privacy) ---
DP_ENABLED=false
DP_EPSILON_TARGET=8.0
DP_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0
DP_NOISE_MULTIPLIER=1.0

# --- Diffusion (MedFusion-inspired; not claimed as original MedFusion) ---
DIFFUSION_ENABLED=false
DIFFUSION_BACKEND=placeholder

# --- LLM / Hugging Face (never expose tokens to the frontend) ---


# --- RAG ---
VECTOR_DB=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fedxai-med

# --- Upload / security ---
MAX_UPLOAD_MB=20
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,dcm,dicom
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_PER_MINUTE=60
